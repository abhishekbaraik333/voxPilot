# Caddyfile — Reverse Proxy Config for VPS
# Exposes the frontend on port 80/443 and routes backend requests internally.

# If you have a domain, replace :80 with your domain (e.g. voxpilot.yourdomain.com)
:80 {
    # Route all WebSocket connections to Fastify backend
    @websockets {
        header Connection *Upgrade*
        header Upgrade    websocket
    }
    reverse_proxy @websockets server:3001

    # Route backend endpoints to Fastify backend
    reverse_proxy /api/* server:3001
    reverse_proxy /ws/* server:3001
    reverse_proxy /webhooks/* server:3001

    # Route all other traffic to Next.js frontend
    reverse_proxy * web:3000

    log {
        output file /var/log/caddy/access.log
    }
}
