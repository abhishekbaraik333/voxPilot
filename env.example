# ==============================================================
# VoxPilot — Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your actual API keys
# ==============================================================

# ─── Server Configuration ─────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ─── Auth (Admin Login Credentials) ───────────────────────────
ADMIN_EMAIL=admin@voxpilot.local
ADMIN_PASSWORD=changeme123
JWT_SECRET=supersecretchangeinproductionplease

# ─── Fonoster Telephony ────────────────────────────────────────
FONOSTER_API_ENDPOINT=localhost:50051
FONOSTER_VOICE_PORT=3002
FONOSTER_ACCESS_KEY_ID=WO00000000000000000000000000000000
FONOSTER_API_KEY=AP00000000000000000000000000000000
FONOSTER_API_SECRET=your_fonoster_api_secret_here
FONOSTER_APP_REF=your_fonoster_app_reference_id_here

# ─── Cellhub SIP Trunk ─────────────────────────────────────────
CELLHUB_SIP_SERVER=195.35.9.6
CELLHUB_SIP_USERNAME=your_cellhub_sip_username_here
CELLHUB_SIP_PASSWORD=your_cellhub_sip_password_here
CELLHUB_CALLER_ID=your_cellhub_outbound_number_here

# ─── Deepgram (Speech-to-Text) ─────────────────────────────────
# Find at: https://console.deepgram.com
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ─── ElevenLabs (Text-to-Speech) ──────────────────────────────
# Find at: https://elevenlabs.io
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM  # Default female natural voice
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5     # Low-latency speech model

# ─── OpenRouter (LLM brain) ────────────────────────────────────
# Find at: https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
DEFAULT_LLM_MODEL=inclusionai/ling-2.6-flash