# ==============================================================
# AI Voice Agent - Environment Configuration
# ==============================================================
# Copy this file to .env and fill in your actual API keys
# ==============================================================

# ─── Twilio Configuration ────────────────────────────────────────
# Get these from: https://console.twilio.com
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"  # Your Twilio phone number (E.164 format)

# ─── ElevenLabs Configuration ────────────────────────────────────
# Get from: https://elevenlabs.io
ELEVENLABS_API_KEY="your_elevenlabs_api_key_here"

# ─── Deepgram Configuration ─────────────────────────────────────
# Get from: https://deepgram.com
DEEPGRAM_API_KEY="your_deepgram_api_key_here"

# ─── OpenAI Configuration ───────────────────────────────────────
# Get from: https://platform.openai.com
OPENAI_API_KEY="your_openai_api_key_here"

# ─── Webhook Configuration ───────────────────────────────────────
# URL where Twilio will send call status updates
# Make this accessible from the internet (use ngrok for testing)
WEBHOOK_URL="http://localhost:5000/webhooks"

# ─── Optional Settings ──────────────────────────────────────────
# Set to "true" to run in test mode (no actual calls)
TEST_CALL="false"

# ─── Advanced Settings ───────────────────────────────────────────
# Debug mode (shows extra info in dashboard)
DEBUG="true"